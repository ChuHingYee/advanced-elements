{
  "name": "@advanced-elements/config-provider",
  "type": "module",
  "version": "0.0.1",
  "description": "ConfigProvider for advanced-elements — global configuration for all components",
  "author": "ChuHingYee",
  "license": "MIT",
  "homepage": "https://github.com/ChuHingYee/advanced-elements#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChuHingYee/advanced-elements.git",
    "directory": "packages/config-provider"
  },
  "bugs": {
    "url": "https://github.com/ChuHingYee/advanced-elements/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vue3",
    "element-plus",
    "config-provider",
    "advanced-elements"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "dev": "rolldown -c -w",
    "build": "rimraf ./dist && rolldown -c && vue-tsc -p tsconfig.dts.json",
    "prepack": "rimraf --glob \"./dist/**/*.map\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@advanced-elements/rolldown-config": "workspace:*",
    "@vue/test-utils": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
