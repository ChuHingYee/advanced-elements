{
  "name": "@advanced-elements/config-provider",
  "type": "module",
  "version": "2.1.0",
  "description": "ConfigProvider for advanced-elements — global configuration for all components",
  "author": "ChuHingYee",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "dev": "rolldown -c -w",
    "build": "rimraf ./dist && rolldown -c && vue-tsc -p tsconfig.dts.json",
    "prepack": "rimraf --glob \"./dist/**/*.map\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@advanced-elements/rolldown-config": "workspace:*",
    "@vue/test-utils": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
